{
  "name": "oscar-movies",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "preview": "next build && next start --port 3000",
    "preview:share": "cloudflared tunnel --url http://localhost:3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "screens": "playwright test tests/screens",
    "data:check": "tsx scripts/check-data.ts",
    "race:check": "tsx scripts/race-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local ./node_modules/.bin/drizzle-kit migrate",
    "db:migrate:test": "node --env-file=.env.test ./node_modules/.bin/drizzle-kit migrate",
    "db:mark-branch": "tsx scripts/mark-branch.ts",
    "db:seed:test": "tsx scripts/seed-test.ts",
    "marks:export": "tsx scripts/marks.ts export",
    "marks:restore": "tsx scripts/marks.ts restore"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "country-flag-icons": "1.6.20",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
