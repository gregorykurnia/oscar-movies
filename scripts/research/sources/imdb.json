      "why": "P'tit Quinquin is a television miniseries",
      "note": "a series"
    },
    "cinema-eye 2021 tt11859366": {
      "why": "Music Box is a television series, not a feature",
      "note": "a series"
    },
    "iowa-critics 2023 tt28607951": {
      "why": "IMDb files Anora (a 2024 film) as a Best Picture winner in the 2024 edition beside The Holdovers (a 2023 film); the group's edition for 2024 films is not on IMDb, so the row is a season off",
      "note": "Anora is filed by IMDb in the edition for 2023 films, a season off"
    },
