# Names only. Copy to .env.local (production: local previews and db:migrate) and to
# .env.test (the test branch: tests and db:migrate:test). Real values never go in git or docs.

# Direct connection string (migrations and scripts):
DATABASE_URL=
# Pooled connection string (the app):
DATABASE_URL_POOLED=
OMDB_API_KEY=
TMDB_READ_TOKEN=
# Vercel sends this to the cron route:
CRON_SECRET=
REVALIDATE_SECRET=
# Where the loader sends the revalidate call: the live URL, or http://localhost:3100 in .env.test:
APP_URL=
# "test" in .env.test only:
EXPECT_DB_BRANCH=
